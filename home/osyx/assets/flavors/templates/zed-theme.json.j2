{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Osyx",
  "author": "osyx",
  "themes": [
    {
      "name": "Osyx",
      "appearance": "dark",
      "style": {
      "background": "#{{ kitty_bg }}",
      "surface.background": "#{{ kitty_bg }}",
      "elevated_surface.background": "#{{ kitty_color6 }}",
      "border": "#{{ kitty_color6 }}",
      "border.variant": "#{{ kitty_color6 }}",
      "border.focused": "#{{ kitty_cursor }}",
      "border.selected": "#{{ kitty_cursor }}",
      "text": "#{{ kitty_fg }}",
      "text.muted": "#{{ kitty_color5 }}",
      "text.placeholder": "#{{ kitty_color5 }}",
      "text.disabled": "#{{ kitty_color5 }}",
      "text.accent": "#{{ kitty_cursor }}",
      "icon": "#{{ kitty_fg }}",
      "icon.muted": "#{{ kitty_color5 }}",
      "icon.accent": "#{{ kitty_cursor }}",
      "element.background": "#{{ kitty_color6 }}",
      "element.hover": "#{{ kitty_color5 }}",
      "element.active": "#{{ kitty_color5 }}",
      "element.selected": "#{{ kitty_color5 }}",
      "ghost_element.hover": "#{{ kitty_color6 }}",
      "ghost_element.selected": "#{{ kitty_color6 }}",
      "title_bar.background": "#{{ kitty_bg }}",
      "status_bar.background": "#{{ kitty_bg }}",
      "toolbar.background": "#{{ kitty_bg }}",
      "tab_bar.background": "#{{ kitty_bg }}",
      "tab.inactive_background": "#{{ kitty_bg }}",
      "tab.active_background": "#{{ kitty_color6 }}",
      "panel.background": "#{{ kitty_bg }}",
      "editor.background": "#{{ kitty_bg }}",
      "editor.foreground": "#{{ kitty_fg }}",
      "editor.gutter.background": "#{{ kitty_bg }}",
      "editor.active_line.background": "#{{ kitty_color6 }}",
      "editor.line_number": "#{{ kitty_color5 }}",
      "editor.active_line_number": "#{{ kitty_cursor }}",
      "terminal.background": "#{{ kitty_bg }}",
      "terminal.foreground": "#{{ kitty_fg }}",
      "terminal.ansi.black": "#{{ kitty_color0 }}",
      "terminal.ansi.bright_black": "#{{ kitty_color8 }}",
      "terminal.ansi.red": "#{{ kitty_color1 }}",
      "terminal.ansi.bright_red": "#{{ kitty_color9 }}",
      "terminal.ansi.green": "#{{ kitty_color2 }}",
      "terminal.ansi.bright_green": "#{{ kitty_color10 }}",
      "terminal.ansi.yellow": "#{{ kitty_color3 }}",
      "terminal.ansi.bright_yellow": "#{{ kitty_color11 }}",
      "terminal.ansi.blue": "#{{ kitty_color4 }}",
      "terminal.ansi.bright_blue": "#{{ kitty_color12 }}",
      "terminal.ansi.magenta": "#{{ kitty_color5 }}",
      "terminal.ansi.bright_magenta": "#{{ kitty_color13 }}",
      "terminal.ansi.cyan": "#{{ kitty_color6 }}",
      "terminal.ansi.bright_cyan": "#{{ kitty_color14 }}",
      "terminal.ansi.white": "#{{ kitty_color7 }}",
      "terminal.ansi.bright_white": "#{{ kitty_color15 }}",
      "syntax": {
        "comment": {"color": "#{{ kitty_color5 }}"},
        "keyword": {"color": "#{{ kitty_color1 }}"},
        "string": {"color": "#{{ kitty_color2 }}"},
        "function": {"color": "#{{ kitty_cursor }}"},
        "type": {"color": "#{{ kitty_color3 }}"},
        "variable": {"color": "#{{ kitty_fg }}"},
        "number": {"color": "#{{ kitty_color4 }}"},
        "constant": {"color": "#{{ kitty_color4 }}"}
      }
      }
    }
  ]
}
